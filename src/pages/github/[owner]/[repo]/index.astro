---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
  sortChangelogEntriesByVersion,
  getChangelogSize,
  isPreRelease,
} from '../../../../changelog/utils';
import { route } from '../../../../utils/route';
import {
  getAllChangelogEntries,
  getChangelogsForPackage,
} from '../../../../db/queries';

export async function getStaticPaths() {
  const entries = getAllChangelogEntries();
  const repos = new Map<string, { owner: string; repo: string }>();

  for (const entry of entries) {
    if (entry.source !== 'github') continue;

    // package is "owner/repo" for GitHub
    const [owner, repo] = entry.package.split('/');
    if (owner && repo) {
      const key = `${owner.toLowerCase()}/${repo.toLowerCase()}`;
      if (!repos.has(key)) {
        repos.set(key, { owner, repo });
      }
    }
  }

  return [...repos.values()].map(({ owner, repo }) => ({
    params: { owner, repo },
  }));
}

const { owner, repo } = Astro.params;
const fullName = `${owner}/${repo}`;
const changelogs = getChangelogsForPackage('github', fullName);

// Sort versions (newest first)
const versions = sortChangelogEntriesByVersion(changelogs);

const repoUrl = `https://github.com/${owner}/${repo}`;
---

<StarlightPage
  frontmatter={{
    title: fullName,
    description: `Changelog versions for ${fullName} from GitHub`,
  }}
>
  <p class="source-info">
    <a href={route("/github/")} class="badge">GitHub</a>
    <span class="separator">/</span>
    <span class="package-name">{fullName}</span>
  </p>

  <p class="package-links">
    <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="link">
      Repository
    </a>
    <span class="separator">·</span>
    <a href={`${repoUrl}/releases`} target="_blank" rel="noopener noreferrer" class="link">
      Releases
    </a>
  </p>

  <div class="filter-container">
    <input
      type="text"
      id="version-filter"
      placeholder="Filter versions..."
      class="filter-input"
    />
    <label class="prerelease-toggle">
      <input type="checkbox" id="hide-prereleases" />
      <span>Hide pre-releases</span>
    </label>
    <span class="version-count">
      <span id="visible-count">{versions.length}</span> of {versions.length} releases
    </span>
    <a href={route(`/github/${owner}/${repo}/compare`)} class="compare-link">
      Compare Versions
    </a>
  </div>

  <div class="versions-list" id="versions-list">
    {
      versions.map((entry) => {
        const size = getChangelogSize(entry.size);
        return (
          <a
            href={route(`/github/${owner}/${repo}/${entry.version}/`)}
            class="version-item"
            data-version={entry.version}
            data-prerelease={isPreRelease(entry.version) ? "true" : undefined}
          >
            <span class="version">{entry.version}</span>
            {size && <span class="size">{size}</span>}
          </a>
        );
      })
    }
  </div>
</StarlightPage>

<style>
  .source-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .badge {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }
  .badge:hover {
    opacity: 0.9;
  }
  .separator {
    color: var(--sl-color-gray-3);
  }
  .package-name {
    font-family: var(--sl-font-mono);
    color: var(--sl-color-gray-2);
  }
  .package-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }
  .package-links .link {
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }
  .package-links .link:hover {
    text-decoration: underline;
  }
  .filter-container {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .filter-input {
    flex: 1;
    min-width: 200px;
    max-width: 300px;
    padding: 0.5rem 0.75rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: 0.875rem;
  }
  .filter-input:focus {
    outline: none;
    border-color: var(--sl-color-accent);
  }
  .filter-input::placeholder {
    color: var(--sl-color-gray-3);
  }
  .version-count {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }
  .compare-link {
    padding: 0.5rem 0.75rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    color: var(--sl-color-white);
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .compare-link:hover {
    background: var(--sl-color-gray-5);
    border-color: var(--sl-color-accent);
  }
  .versions-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .version-item {
    display: flex;
    align-items: center;
    padding: 0.5rem 0;
    text-decoration: none;
    font-family: var(--sl-font-mono);
    font-size: 0.875rem;
    border-bottom: 1px solid var(--sl-color-gray-6);
  }
  .version-item:first-child {
    border-top: 1px solid var(--sl-color-gray-6);
  }
  .version-item:hover {
    background: var(--sl-color-gray-6);
  }
  .version {
    color: var(--sl-color-white);
  }
  .size {
    color: var(--sl-color-gray-3);
    font-size: 0.75rem;
    margin-left: auto;
  }
  .version-item.hidden {
    display: none;
  }
  .prerelease-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--sl-color-gray-2);
    user-select: none;
  }
  .prerelease-toggle input[type="checkbox"] {
    width: 1rem;
    height: 1rem;
    cursor: pointer;
    accent-color: var(--sl-color-accent);
  }
  .prerelease-toggle:hover {
    color: var(--sl-color-white);
  }
</style>

<script>
  const STORAGE_KEY = 'clhub:hidePreReleases';

  const filterInput = document.getElementById('version-filter') as HTMLInputElement;
  const hidePrereleasesCheckbox = document.getElementById('hide-prereleases') as HTMLInputElement;
  const versionsList = document.getElementById('versions-list');
  const visibleCount = document.getElementById('visible-count');
  const versionItems = versionsList?.querySelectorAll('.version-item') ?? [];

  // Load saved preference
  if (localStorage.getItem(STORAGE_KEY) === 'true') {
    hidePrereleasesCheckbox.checked = true;
  }

  function applyFilters() {
    const query = filterInput?.value.toLowerCase().trim() ?? '';
    const hidePrereleases = hidePrereleasesCheckbox?.checked ?? false;
    let visible = 0;

    versionItems.forEach((item) => {
      const version = item.getAttribute('data-version')?.toLowerCase() ?? '';
      const isPrerelease = item.hasAttribute('data-prerelease');
      const shouldShow = version.includes(query) && (!hidePrereleases || !isPrerelease);
      item.classList.toggle('hidden', !shouldShow);
      if (shouldShow) visible++;
    });

    if (visibleCount) visibleCount.textContent = String(visible);
  }

  applyFilters(); // Apply on page load

  filterInput?.addEventListener('input', applyFilters);
  hidePrereleasesCheckbox?.addEventListener('change', () => {
    localStorage.setItem(STORAGE_KEY, String(hidePrereleasesCheckbox.checked));
    applyFilters();
  });
</script>
