---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CopyButton from '../../../../components/CopyButton.astro';
import { route } from '../../../../utils/route';
import { getAllChangelogEntries } from '../../../../db/queries';
import { renderMarkdown } from '../../../../db/markdown';
import { getChangelogUrl } from '../../../../changelog/packages';

export async function getStaticPaths() {
  const entries = getAllChangelogEntries();

  return entries
    .filter((entry) => entry.source === 'github')
    .map((entry) => {
      // package is "owner/repo" for GitHub
      const [owner, repo] = entry.package.split('/');

      return {
        params: {
          owner,
          repo,
          version: entry.version,
        },
        props: { entry },
      };
    });
}

const { owner, repo, version } = Astro.params;
const { entry } = Astro.props;
const html = await renderMarkdown(entry.markdown);

const fullName = `${owner}/${repo}`;
const changelogUrl = getChangelogUrl('github', fullName, version!);
---

<StarlightPage
	frontmatter={{
		title: `${fullName} ${version}`,
		description: `Release notes for ${fullName} version ${version} from GitHub`,
		pagefind: false, // version pages should not be indexed with pagefind
	}}
>
  <div class="header-container">
    <p class="breadcrumb">
      <a href={route("/github/")} class="badge">GitHub</a>
      <span class="separator">/</span>
      <a href={route(`/github/${owner}/${repo}/`)} class="package-name">{fullName}</a>
      <span class="separator">/</span>
      <span class="version">{version}</span>
      {changelogUrl && (
        <a href={changelogUrl} target="_blank" rel="noopener noreferrer" class="source-link-inline">
          source <span class="arrow">↗</span>
        </a>
      )}
    </p>
    <CopyButton content={entry.markdown} />
  </div>

	<div class="changelog-content">
		<Fragment set:html={html} />
	</div>
</StarlightPage>

<style>
	.changelog-content {
		position: relative;
	}
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
	}
	.badge {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		padding: 0.25rem 0.5rem;
		border-radius: 0.25rem;
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
	}
	.badge:hover {
		opacity: 0.9;
	}
	.separator {
		color: var(--sl-color-gray-3);
	}
	.package-name {
		font-family: var(--sl-font-mono);
		color: var(--sl-color-text);
		text-decoration: none;
	}
	.package-name:hover {
		color: var(--sl-color-accent);
	}
  .version {
    font-family: var(--sl-font-mono);
    color: var(--sl-color-gray-2);
  }
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0;
  }
  .source-link-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--sl-color-text);
    text-decoration: none;
    font-size: 0.875rem;
    margin-left: 0.5rem;
  }
  .source-link-inline:hover {
    color: var(--sl-color-accent);
  }
  .arrow {
    font-size: 0.75rem;
  }
</style>
