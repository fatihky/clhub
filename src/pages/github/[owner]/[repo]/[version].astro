---
import { getCollection, render } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CopyButton from '../../../../components/CopyButton.astro';
import { parseChangelogPath } from '../../../../changelog/utils';
import { route } from '../../../../utils/route';

export async function getStaticPaths() {
  const changelogs = await getCollection('changelogs', ({ id }) =>
    id.startsWith('github/'),
  );

  return changelogs.map((entry) => {
    const parsed = parseChangelogPath(entry.filePath ?? entry.id);
    // pkg is "owner/repo" for GitHub
    const [owner, repo] = parsed.pkg.split('/');

    return {
      params: {
        owner,
        repo,
        version: parsed.version,
      },
      props: { entry },
    };
  });
}

const { owner, repo, version } = Astro.params;
const { entry } = Astro.props;
const { Content } = await render(entry);

const fullName = `${owner}/${repo}`;
---

<StarlightPage
	frontmatter={{
		title: `${fullName} ${version}`,
		description: `Release notes for ${fullName} version ${version} from GitHub`,
	}}
>
	<p class="breadcrumb">
		<a href={route("/github/")} class="badge">GitHub</a>
		<span class="separator">/</span>
		<a href={route(`/github/${owner}/${repo}/`)} class="package-name">{fullName}</a>
		<span class="separator">/</span>
		<span class="version">{version}</span>
		{entry.body && <CopyButton content={entry.body} />}
	</p>

	<div class="changelog-content">
		<Content />
	</div>
</StarlightPage>

<style>
	.changelog-content {
		position: relative;
	}
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
	}
	.badge {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		padding: 0.25rem 0.5rem;
		border-radius: 0.25rem;
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
	}
	.badge:hover {
		opacity: 0.9;
	}
	.separator {
		color: var(--sl-color-gray-3);
	}
	.package-name {
		font-family: var(--sl-font-mono);
		color: var(--sl-color-text);
		text-decoration: none;
	}
	.package-name:hover {
		color: var(--sl-color-accent);
	}
	.version {
		font-family: var(--sl-font-mono);
		color: var(--sl-color-gray-2);
	}
</style>
