---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { extractVersionFromPath, sortChangelogEntriesByVersion, getChangelogSize } from "../../../../changelog/utils";
import { getPackageLinks } from "../../../../changelog/packages";

const sourceLabels: Record<string, string> = {
  crates: "Crates.io",
  npm: "npm",
  pypi: "PyPI",
  rubygems: "RubyGems",
};

export async function getStaticPaths() {
  const changelogs = await getCollection("changelogs");
  const packages = new Map<string, { source: string; pkg: string }>();

  for (const entry of changelogs) {
    const filePath = entry.filePath || "";
    const parts = entry.id.split("/");
    const source = parts[0];

    // Skip github - handled by separate route
    if (source === "github") continue;

    // Skip scoped packages - handled by separate route (use filePath since ID strips @)
    if (filePath.match(/changelogs\/\w+\/@[^/]+\//)) continue;

    const pkg = parts[1];
    const key = `${source}/${pkg}`;
    if (!packages.has(key)) {
      packages.set(key, { source, pkg });
    }
  }

  return [...packages.values()].map(({ source, pkg }) => ({
    params: { source, pkg },
  }));
}

const { source, pkg } = Astro.params;
const changelogs = await getCollection("changelogs", ({ id }) =>
  id.startsWith(`${source}/${pkg}/`),
);

// Sort versions (newest first)
const versions = sortChangelogEntriesByVersion(changelogs);

const sourceLabel = source ? sourceLabels[source] ?? source : "Unknown";
const packageLinks = source && pkg ? await getPackageLinks(source, pkg) : undefined;
---

<StarlightPage
  frontmatter={{
    title: pkg ?? "Package",
    description: `Changelog versions for ${pkg} from ${sourceLabel}`,
  }}
>
  <p class="source-info">
    <a href={`/changelogs/${source}/`} class="badge">{sourceLabel}</a>
    <span class="separator">/</span>
    <span class="package-name">{pkg}</span>
  </p>

  {packageLinks && (
    <p class="package-links">
      <a href={packageLinks.homepage} target="_blank" rel="noopener noreferrer" class="link">
        View on {sourceLabel}
      </a>
    </p>
  )}

  <div class="filter-container">
    <input
      type="text"
      id="version-filter"
      placeholder="Filter versions..."
      class="filter-input"
    />
    <span class="version-count">
      <span id="visible-count">{versions.length}</span> of {versions.length} versions
    </span>
    <a href={`/changelogs/${source}/${pkg}/compare`} class="compare-link">
      Compare Versions
    </a>
  </div>

  <div class="versions-list" id="versions-list">
    {
      versions.map((entry) => {
        const version = extractVersionFromPath(entry.filePath ?? entry.id);
        const size = getChangelogSize(entry.filePath);

        return (
          <a
            href={`/changelogs/${source}/${pkg}/${version}/`}
            class="version-item"
            data-version={version}
          >
            <span class="version">{version}</span>
            {size && <span class="size">{size}</span>}
          </a>
        );
      })
    }
  </div>
</StarlightPage>

<style>
  .source-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .badge {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }
  .badge:hover {
    opacity: 0.9;
  }
  .separator {
    color: var(--sl-color-gray-3);
  }
  .package-name {
    font-family: var(--sl-font-mono);
    color: var(--sl-color-gray-2);
  }
  .package-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }
  .package-links .link {
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }
  .package-links .link:hover {
    text-decoration: underline;
  }
  .filter-container {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .filter-input {
    flex: 1;
    min-width: 200px;
    max-width: 300px;
    padding: 0.5rem 0.75rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: 0.875rem;
  }
  .filter-input:focus {
    outline: none;
    border-color: var(--sl-color-accent);
  }
  .filter-input::placeholder {
    color: var(--sl-color-gray-3);
  }
  .version-count {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }
  .compare-link {
    padding: 0.5rem 0.75rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    color: var(--sl-color-white);
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .compare-link:hover {
    background: var(--sl-color-gray-5);
    border-color: var(--sl-color-accent);
  }
  .versions-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .version-item {
    display: flex;
    align-items: center;
    padding: 0.5rem 0;
    text-decoration: none;
    font-family: var(--sl-font-mono);
    font-size: 0.875rem;
    border-bottom: 1px solid var(--sl-color-gray-6);
  }
  .version-item:first-child {
    border-top: 1px solid var(--sl-color-gray-6);
  }
  .version-item:hover {
    background: var(--sl-color-gray-6);
  }
  .version {
    color: var(--sl-color-white);
  }
  .size {
    color: var(--sl-color-gray-3);
    font-size: 0.75rem;
    margin-left: auto;
  }
  .version-item.hidden {
    display: none;
  }
</style>

<script>
  const filterInput = document.getElementById(
    "version-filter",
  ) as HTMLInputElement;
  const versionsList = document.getElementById("versions-list");
  const visibleCount = document.getElementById("visible-count");
  const versionItems = versionsList?.querySelectorAll(".version-item") ?? [];

  filterInput?.addEventListener("input", () => {
    const query = filterInput.value.toLowerCase().trim();
    let visible = 0;

    versionItems.forEach((item) => {
      const version = item.getAttribute("data-version")?.toLowerCase() ?? "";
      const matches = version.includes(query);
      item.classList.toggle("hidden", !matches);
      if (matches) visible++;
    });

    if (visibleCount) {
      visibleCount.textContent = String(visible);
    }
  });
</script>
