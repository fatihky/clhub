---
import { getCollection, render } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import CopyButton from "../../../../../components/CopyButton.astro";
import { extractVersionFromPath } from "../../../../../changelog/utils";

const sourceLabels: Record<string, string> = {
  crates: "Crates.io",
  npm: "npm",
  pypi: "PyPI",
  rubygems: "RubyGems",
};

export async function getStaticPaths() {
  const changelogs = await getCollection("changelogs");

  return changelogs
    .filter((entry) => {
      // Use filePath to detect scoped packages (ID strips @ symbol)
      const filePath = entry.filePath || "";
      // Skip github - handled by separate route
      if (filePath.includes("/github/")) return false;
      // Only handle scoped packages
      return filePath.match(/changelogs\/\w+\/@[^/]+\/[^/]+\//);
    })
    .map((entry) => {
      const filePath = entry.filePath || "";
      const match = filePath.match(/changelogs\/(\w+)\/@([^/]+)\/([^/]+)\//);
      if (!match) return null;

      return {
        params: {
          source: match[1],
          org: match[2],
          pkg: match[3],
          version: extractVersionFromPath(filePath),
        },
        props: { entry },
      };
    })
    .filter(Boolean);
}

const { source, org, pkg, version } = Astro.params;
const fullPkg = `@${org}/${pkg}`;
const { entry } = Astro.props;
const { Content } = await render(entry);

const sourceLabel = sourceLabels[source!] || source;
---

<StarlightPage
  frontmatter={{
    title: `${fullPkg} ${version}`,
    description: `Changelog for ${fullPkg} version ${version} from ${sourceLabel}`,
  }}
>
  <p class="breadcrumb">
    <a href={`/changelogs/${source}/`} class="badge">{sourceLabel}</a>
    <span class="separator">/</span>
    <a href={`/changelogs/${source}/@${org}/${pkg}/`} class="package-name">{fullPkg}</a>
    <span class="separator">/</span>
    <span class="version">{version}</span>
    {entry.body && <CopyButton content={entry.body} />}
  </p>

  <div class="changelog-content">
    <Content />
  </div>
</StarlightPage>

<style>
  .changelog-content {
    position: relative;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .badge {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }
  .badge:hover {
    opacity: 0.9;
  }
  .separator {
    color: var(--sl-color-gray-3);
  }
  .package-name {
    font-family: var(--sl-font-mono);
    color: var(--sl-color-text);
    text-decoration: none;
  }
  .package-name:hover {
    color: var(--sl-color-accent);
  }
  .version {
    font-family: var(--sl-font-mono);
    color: var(--sl-color-gray-2);
  }
</style>
