---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
  PACKAGE_MANAGERS,
  type PackageManagerKey,
} from '../changelog/package-managers';
import { route } from '../utils/route';

const sourceLabels: Record<PackageManagerKey, string> = {
  npm: 'npm',
  github: 'GitHub',
  crates: 'Crates.io',
  pypi: 'PyPI',
  rubygems: 'RubyGems',
};

const sourceDescriptions: Record<PackageManagerKey, string> = {
  npm: 'JavaScript packages from the npm registry',
  github: 'Release notes from GitHub repositories',
  crates: 'Rust crates from crates.io',
  pypi: 'Python packages from PyPI',
  rubygems: 'Ruby gems from RubyGems.org',
};

const packageManagers = Object.keys(PACKAGE_MANAGERS) as PackageManagerKey[];
---

<StarlightPage
	frontmatter={{
		title: 'Changelog Hub',
		description: 'Browse changelogs from npm, GitHub, Crates.io, PyPI, and RubyGems',
	}}
>
	<p>Browse changelogs from popular package registries and GitHub releases.</p>

	<div class="sources-grid">
		{packageManagers.map((source) => (
			<a href={route(`/${source}/`)} class="source-card">
				<h2>{sourceLabels[source]}</h2>
				<p class="description">{sourceDescriptions[source]}</p>
			</a>
		))}
	</div>
</StarlightPage>

<style>
	.sources-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}
	.source-card {
		display: block;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 1.5rem;
		background: var(--sl-color-gray-6);
		text-decoration: none;
		transition: border-color 0.2s, background 0.2s;
	}
	.source-card:hover {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-gray-5);
	}
	.source-card h2 {
		margin: 0 0 0.5rem 0;
		font-size: 1.25rem;
		color: var(--sl-color-white);
	}
	.description {
		margin: 0;
		font-size: 0.875rem;
		color: var(--sl-color-gray-2);
	}
</style>
